int pesquisaBinaria(int *v, int inicio, int fim, int chave){
    
    while(fim >= inicio){
        int Imeio = (inicio + fim)/2;
        if(v[Imeio] == chave){
            printf("Encontrou esta no indice: ", Imeio);
            return 1;
        }else if (v[Imeio] < chave){
           fim = Imeio;
        }else{
            inicio = Imeio;
        }
    }
    return 0;
}


void quick(int vet[], int esq, int dir){
    int pivo = esq, i,ch,j;         
    for(i=esq+1;i<=dir;i++){        
        j = i;                      
        if(vet[j] < vet[pivo]){     
            ch = vet[j];               
            while(j > pivo){           
                vet[j] = vet[j-1];      
                j--;                    
            }
            vet[j] = ch;               
            pivo++;                    
        }
    }
    if(pivo-1 >= esq){              
        quick(vet,esq,pivo-1);      
    }
    if(pivo+1 <= dir){              
        quick(vet,pivo+1,dir);      
    }
